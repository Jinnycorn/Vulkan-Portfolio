#version 450
#extension GL_KHR_vulkan_glsl : enable

// FSR 2.2 integration-facing temporal reconstruction pass. The engine supplies the
// same application-owned inputs required by the FSR2 Vulkan backend: jittered color
// and depth, unjittered motion vectors, exposure history and a reactive mask.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform SceneDataUBO {
    mat4 projection;
    mat4 view;
    vec3 cameraPos;
    float padding1;
    vec3 directionalLightDir;
    float padding2;
    vec3 directionalLightColor;
    float padding3;
    mat4 lightSpaceMatrix;
    mat4 projectionNoJitter;
    mat4 previousProjectionNoJitter;
    mat4 previousView;
    vec4 temporalJitter;
    vec4 temporalParams;
    vec4 temporalExposure;
} sceneData;

layout(set = 0, binding = 1) uniform PostProcessingOptions {
    int toneMappingType;
    float exposure;
    float gamma;
    float maxWhite;
    float contrast;
    float brightness;
    float saturation;
    float vibrance;
    float vignetteStrength;
    float vignetteRadius;
    float filmGrainStrength;
    float chromaticAberration;
    int debugMode;
    int showOnlyChannel;
    float debugSplit;
    float padding1;
    int nisEnabled;
    float nisSharpness;
    float nisScaleThreshold;
    float nisPadding;
} postOptions;

layout(set = 0, binding = 2) uniform sampler2D floatColor2;
layout(set = 0, binding = 3) uniform sampler2D depthStencil;
layout(set = 0, binding = 4) uniform sampler2D gMotion;
layout(set = 0, binding = 5) uniform sampler2D gReactive;
layout(set = 0, binding = 6) uniform sampler2D historyColorPrev;
layout(set = 0, binding = 7) uniform sampler2D historyDepthPrev;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D temporalOutput;
layout(set = 0, binding = 9, rgba16f) uniform writeonly image2D historyColorCurrent;
layout(set = 0, binding = 10, r32f) uniform writeonly image2D historyDepthCurrent;

vec3 sampleCurrent(vec2 uv)
{
    return texture(floatColor2, clamp(uv, vec2(0.0), vec2(1.0))).rgb;
}

vec3 rgbToYCoCg(vec3 color)
{
    return vec3(
        0.25 * color.r + 0.5 * color.g + 0.25 * color.b,
        0.5 * color.r - 0.5 * color.b,
        -0.25 * color.r + 0.5 * color.g - 0.25 * color.b);
}

vec3 yCoCgToRgb(vec3 color)
{
    return vec3(
        color.x + color.y - color.z,
        color.x + color.z,
        color.x - color.y - color.z);
}

// Variance clipping is deliberately performed in a luminance/chroma space. The old
// per-channel min/max box changed abruptly whenever a sub-pixel window frame or brick
// entered/leaved the 3x3 footprint, continuously discarding otherwise valid history.
void neighborhoodStatistics(vec2 uv, out vec3 mean, out vec3 sigma)
{
    vec2 texel = 1.0 / vec2(textureSize(floatColor2, 0));
    mean = vec3(0.0);
    vec3 secondMoment = vec3(0.0);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec3 value = rgbToYCoCg(sampleCurrent(uv + vec2(x, y) * texel));
            mean += value;
            secondMoment += value * value;
        }
    }
    mean *= 1.0 / 9.0;
    secondMoment *= 1.0 / 9.0;
    sigma = sqrt(max(secondMoment - mean * mean, vec3(0.0)));
}

void main()
{
    ivec2 outputSize = imageSize(temporalOutput);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, outputSize))) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(outputSize);

    // GLM's right-handed projection stores clip.w = -view.z. Therefore adding a
    // positive offset to projection[2][0/1] moves the rasterized image in the
    // negative UV direction. Sample in that same negative direction to place the
    // jittered input back on the stable output grid.
    vec2 renderSize = vec2(textureSize(floatColor2, 0));
    vec2 currentJitterUv = sceneData.temporalJitter.xy / max(renderSize, vec2(1.0));
    vec2 halfTexel = 0.5 / max(renderSize, vec2(1.0));
    vec2 currentUv = clamp(uv - currentJitterUv, halfTexel, vec2(1.0) - halfTexel);

    vec3 currentColor = sampleCurrent(currentUv);
    float currentDepth = texture(depthStencil, currentUv).r;

    // Motion is previous-current NDC. Full-screen UV uses the same orientation, so half
    // an NDC unit converts it to normalized texture coordinates.
    vec2 motion = texture(gMotion, currentUv).rg;
    float stationaryLock = clamp(sceneData.temporalExposure.z, 0.0, 1.0);
    // Half-float motion targets can retain tiny non-zero values on otherwise static
    // geometry. At output resolution those values make history walk between adjacent
    // texels. Remove only sub-quarter-pixel motion while the camera lock is active.
    vec2 motionPixels = motion * 0.5 * vec2(outputSize);
    if (stationaryLock > 0.5 && length(motionPixels) < 0.25) {
        motion = vec2(0.0);
    }
    vec2 previousUv = uv + motion * 0.5;
    float reactive = clamp(texture(gReactive, currentUv).r, 0.0, 1.0);

    bool reset = sceneData.temporalParams.x > 0.5 || postOptions.nisEnabled != 0;
    bool outside = any(lessThan(previousUv, vec2(0.0))) ||
                   any(greaterThan(previousUv, vec2(1.0)));
    vec3 resolved = currentColor;

    if (!reset && !outside) {
        vec3 history = texture(historyColorPrev, previousUv).rgb;
        float previousDepth = texture(historyDepthPrev, previousUv).r;
        float exposureRatio = sceneData.temporalExposure.y /
            max(sceneData.temporalExposure.x, 1e-4);
        history *= exposureRatio;

        vec3 mean;
        vec3 sigma;
        neighborhoodStatistics(currentUv, mean, sigma);

        vec3 historyYCoCg = rgbToYCoCg(history);
        vec3 currentYCoCg = rgbToYCoCg(currentColor);
        // A wider luminance interval preserves stable sub-pixel geometry; tighter chroma
        // bounds still prevent colored ghost trails.
        vec3 gamma = mix(vec3(1.60, 1.15, 1.15),
                         vec3(2.60, 1.60, 1.60), stationaryLock);
        // The old min/max intersection reintroduced the same frame-dependent hard box
        // that variance clipping was meant to replace. A wider statistical interval is
        // stable for static sub-pixel geometry while reactive/depth rejection still
        // handles genuinely changing pixels.
        vec3 clipMinimum = mean - gamma * sigma;
        vec3 clipMaximum = mean + gamma * sigma;
        historyYCoCg = clamp(historyYCoCg, clipMinimum, clipMaximum);
        history = yCoCgToRgb(historyYCoCg);

        float depthDelta = abs(previousDepth - currentDepth);
        float disocclusion = smoothstep(0.0015, 0.02, depthDelta);
        float motionRejection = clamp(length(motion) * 12.0, 0.0, 1.0);
        float luminanceDelta = abs(historyYCoCg.x - currentYCoCg.x) /
            max(max(historyYCoCg.x, currentYCoCg.x), 0.08);
        float temporalInstability = smoothstep(0.10, 0.65, luminanceDelta);
        float baseHistoryWeight = mix(0.965, 0.992, stationaryLock);
        float historyWeight = baseHistoryWeight * (1.0 - reactive) *
            (1.0 - disocclusion) * (1.0 - 0.55 * motionRejection) *
            (1.0 - 0.20 * temporalInstability);
        resolved = mix(currentColor, history, clamp(historyWeight, 0.0, 0.995));
    }

    imageStore(temporalOutput, pixel, vec4(resolved, 1.0));
    imageStore(historyColorCurrent, pixel, vec4(resolved, 1.0));
    imageStore(historyDepthCurrent, pixel, vec4(currentDepth, 0.0, 0.0, 0.0));
}
